      "x": -2929.2242567331423,
      "y": 3568.020124453602,
      "width": 795.39990234375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
