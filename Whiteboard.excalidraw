      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094477,
      "link": null,
      "locked": false,
      "text": "The existing equipment has been tested. Its future\ndigital integration with SÆVIT is part of the proposed\ndevelopment.",
      "fontSize": 27.648312256216304,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The existing equipment has been tested. Its future digital integration with SÆVIT is part of the proposed development.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
