      "link": null,
      "locked": false,
      "text": "6. Copernicus Marine Integration",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6. Copernicus Marine Integration",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vKraeKLXSklX8NmNfLyvn",
      "type": "text",
      "x": 2838.088368363247,
      "y": 5778.6570245912735,
      "width": 731.601709037131,
      "height": 34.56039032027038,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 165528240,
      "version": 109,
      "versionNonce": 363964592,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094478,
      "link": null,
      "locked": false,
      "text": "Copernicus Marine is central to our hackathon project.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Copernicus Marine is central to our hackathon project.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "c-jIQhyWtNiNIMiAhW6At",
      "type": "text",
      "x": 2845.7883972905947,
      "y": 5832.966209380269,
      "width": 716.2016511824351,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 1574502480,
      "version": 109,
      "versionNonce": 1020859056,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094478,
      "link": null,
      "locked": false,
      "text": "Rather than developing our own marine forecasting\nsystems, we want to use existing scientific data and\nmake it more accessible and practical for fishermen.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rather than developing our own marine forecasting systems, we want to use existing scientific data and make it more accessible and practical for fishermen.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "5wD9cR7cDVSCvSouJ6eJt",
      "type": "text",
