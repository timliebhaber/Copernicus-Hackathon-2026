      "version": 109,
      "versionNonce": 1463385264,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094486,
      "link": null,
      "locked": false,
      "text": "With cameras, intelligent monitoring and future emergency-\nsystem integration, we see an opportunity to improve\nsafety for people working alone at sea.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "With cameras, intelligent monitoring and future emergency-system integration, we see an opportunity to improve safety for people working alone at sea.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "OXOwoXzPKecuvdQBMl0XR",
      "type": "text",
      "x": 2827.8446455292,
      "y": 21266.649086689584,
      "width": 752.0891547052242,
      "height": 103.68117096081113,
      "angle": 0,
