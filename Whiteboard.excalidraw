    },
    {
      "id": "mX9DYEDnfNYA042jKxgrq",
      "type": "text",
      "x": 2819.4809997320554,
      "y": 7425.212763421299,
      "width": 768.8164462995144,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
