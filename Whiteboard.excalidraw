      "seed": 1849263560,
      "version": 3,
      "versionNonce": 1780378056,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308146,
      "link": null,
      "locked": false,
      "text": "Use these exact questions to sound knowledgeable and uncover their supply\nchain gaps:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use these exact questions to sound knowledgeable and uncover their supply chain gaps:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "LWmvTVrCwuMHxpYuA-vCc",
      "type": "text",
      "x": -2836.854261615955,
      "y": 3148.020124453602,
      "width": 610.659912109375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4y",
      "roundness": null,
      "seed": 1348508344,
      "version": 3,
      "versionNonce": 481031864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308146,
      "link": null,
      "locked": false,
      "text": "* **When calling Marea (Bioplastics) or Taramar (Cosmetics):**",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* **When calling Marea (Bioplastics) or Taramar (Cosmetics):**",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "bl0uRc-3HVflFjvAR7nEa",
      "type": "text",
      "x": -2929.274244526111,
      "y": 3120.520124453602,
      "width": 795.4998779296875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4z",
      "roundness": null,
      "seed": 1469418696,
      "version": 3,
      "versionNonce": 1295904968,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308147,
      "link": null,
      "locked": false,
      "text": "> *\"As you scale production, are you relying purely on wild-harvested Icelandic\nmacroalgae, or are you looking to secure cultivated biomass from longline seaweed\nfarms? We are using Copernicus satellite and oceanographic data to map optimal\nhigh-nutrient growth zones—especially downstream from aquaculture nutrient\nplumes—and predict late-spring biofouling windows so harvesters can maximize\npolysaccharide purity.\"*",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> *\"As you scale production, are you relying purely on wild-harvested Icelandic macroalgae, or are you looking to secure cultivated biomass from longline seaweed farms? We are using Copernicus satellite and oceanographic data to map optimal high-nutrient growth zones—especially downstream from aquaculture nutrient plumes—and predict late-spring biofouling windows so harvesters can maximize polysaccharide purity.\"*",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "yeDcMWQOQJxrdj9la8l_u",
      "type": "text",
      "x": -2856.6742384225954,
      "y": 3378.020124453602,
      "width": 650.2998657226562,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b50",
      "roundness": null,
      "seed": 1072464824,
      "version": 3,
      "versionNonce": 577527736,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308147,
      "link": null,
      "locked": false,
      "text": "* **When calling Íslenska Kalkþörungafélagið (Seabed Red Algae):**",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* **When calling Íslenska Kalkþörungafélagið (Seabed Red Algae):**",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "CTQKmN1f9d4UC_K5PrrXU",
      "type": "text",
      "x": -2915.88429091283,
      "y": 3363.020124453602,
      "width": 768.719970703125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b51",
      "roundness": null,
      "seed": 1708700616,
      "version": 3,
      "versionNonce": 1356109768,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308148,
      "link": null,
      "locked": false,
      "text": "> *\"Since you operate in Arnarfjörður alongside major salmon farming sites, how\ndo you currently monitor water turbidity, suspended sediment plumes, and\nseasonal phytoplankton dynamics across your licensing areas? Could satellite-\nderived turbidity and chlorophyll tracking help streamline your environmental\ncompliance reporting?\"*",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> *\"Since you operate in Arnarfjörður alongside major salmon farming sites, how do you currently monitor water turbidity, suspended sediment plumes, and seasonal phytoplankton dynamics across your licensing areas? Could satellite-derived turbidity and chlorophyll tracking help streamline your environmental compliance reporting?\"*",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "GNixEmyZEnDiPMskXys5I",
      "type": "text",
      "x": -2870.4442884714235,
      "y": 3583.020124453602,
      "width": 677.8399658203125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b52",
      "roundness": null,
      "seed": 135482552,
      "version": 3,
      "versionNonce": 1178052792,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308148,
      "link": null,
      "locked": false,
      "text": "* **When calling Stika (ESG Software) or Maritech (Seafood ERP):**",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
