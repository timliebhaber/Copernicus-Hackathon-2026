      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094481,
      "link": null,
      "locked": false,
      "text": "Safety is one of the most important long-term ambitions\nof SÆVIT.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Safety is one of the most important long-term ambitions of SÆVIT.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IInZjZ56lp77rJO4gcWd7",
      "type": "text",
      "x": 2812.9836596109226,
      "y": 10397.40633096455,
      "width": 781.8111265417795,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1h",
      "roundness": null,
      "seed": 1788427344,
      "version": 109,
      "versionNonce": 150477488,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094481,
      "link": null,
      "locked": false,
      "text": "A single-handed fisherman may be vulnerable if an accident\noccurs while working on deck.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A single-handed fisherman may be vulnerable if an accident occurs while working on deck.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qNazJagyFe5blzTRDGX8b",
      "type": "text",
      "x": 2834.839683235546,
      "y": 10520.836296394087,
      "width": 738.0990792925323,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1i",
      "roundness": null,
      "seed": 333672624,
      "version": 109,
      "versionNonce": 578897072,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094481,
      "link": null,
      "locked": false,
      "text": "We want to explore whether cameras and AI could help\ndetect unusual or potentially dangerous situations.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We want to explore whether cameras and AI could help detect unusual or potentially dangerous situations.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
