      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094479,
      "link": null,
      "locked": false,
      "text": "“The surface current forecast indicates a northeastward\ncurrent in this location.”",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“The surface current forecast indicates a northeastward current in this location.”",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "23trgilpiFqM1e44kKcZr",
      "type": "text",
      "x": 2819.660780780335,
      "y": 8165.79255599852,
      "width": 768.4568842029555,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 2068526160,
      "version": 109,
      "versionNonce": 2004167344,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094479,
      "link": null,
      "locked": false,
      "text": "The system must identify the source, forecast time, and\nunits.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The system must identify the source, forecast time, and units.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "m9QO3oRWTJBosC_O16ZGo",
      "type": "text",
      "x": 2846.5764084224265,
      "y": 8271.942326267923,
      "width": 714.6256289187718,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1K",
      "roundness": null,
      "seed": 426571952,
      "version": 109,
      "versionNonce": 1591497904,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094479,
      "link": null,
      "locked": false,
      "text": "For the hackathon, our main technical objective is to\ndemonstrate a functioning connection to actual\nCopernicus Marine data.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For the hackathon, our main technical objective is to demonstrate a functioning connection to actual Copernicus Marine data.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
