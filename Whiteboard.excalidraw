      "x": 2547.1445901084207,
      "y": -2284.6405585445395,
      "width": 1376.1441650390625,
      "height": 735,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 352612016,
      "version": 1032,
      "versionNonce": 837134280,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792243611572,
      "created": 1792238556074,
      "link": null,
      "locked": false,
      "text": "AI Crewmember to empower smaller fishermen to compete with big companies. And decentralize fishing\n\n- Cameras\n- Automatic fishing after sonar recognition\n- Heat level, high tides, low tides\n- Renting, modular system\n- Alarm system\n- Communication with headset\n- Company (psychology)\n- Start with satelite data to find optimal fishing spots, generate date with this\n\n\n- Cost: Hardware, Installments, Software dev\n- Benefits: Better fishing rate, psychological support, Efficient manouvering\n- Problems: How are you planning to scale\n\n- Data: Wind, wave, Salt level, Temperature,\n\n- Big trollers scrape bottom, killing 50-70% of the fish\n- Smaller Jig fishing \n",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AI Crewmember to empower smaller fishermen to compete with big companies. And decentralize fishing\n\n- Cameras\n- Automatic fishing after sonar recognition\n- Heat level, high tides, low tides\n- Renting, modular system\n- Alarm system\n- Communication with headset\n- Company (psychology)\n- Start with satelite data to find optimal fishing spots, generate date with this\n\n\n- Cost: Hardware, Installments, Software dev\n- Benefits: Better fishing rate, psychological support, Efficient manouvering\n- Problems: How are you planning to scale\n\n- Data: Wind, wave, Salt level, Temperature,\n\n- Big trollers scrape bottom, killing 50-70% of the fish\n- Smaller Jig fishing \n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
