      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094485,
      "link": null,
      "locked": false,
      "text": "We want SÆVIT to help look after the fisherman too.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We want SÆVIT to help look after the fisherman too.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "rXXlp1ipdc80-hnumENDU",
      "type": "text",
      "x": 2814.0481526599456,
      "y": 21108.658730939776,
      "width": 779.6821404437334,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
