      "link": null,
      "locked": false,
      "text": "1. The Vision",
      "fontSize": 27.648312256216304,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. The Vision",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mPDNEWy_DZajrRp7G5Or8",
      "type": "text",
      "x": 2839.5951722112386,
      "y": -1269.1940014352915,
      "width": 728.588101341148,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ae",
      "roundness": null,
      "seed": 882962608,
      "version": 111,
      "versionNonce": 735024568,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792243565716,
      "created": 1792242094473,
      "link": null,
      "locked": false,
      "text": "Every fisherman working alone at sea deserves a\nfirst mate.",
      "fontSize": 27.648312256216304,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every fisherman working alone at sea deserves a first mate.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "L2f3qqIc0rJL5CAY-qixl",
      "type": "text",
      "x": 2823.628318892733,
      "y": -1163.044231165892,
      "width": 760.5218079781588,
      "height": 103.68117096081112,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af",
      "roundness": null,
      "seed": 380088912,
      "version": 111,
      "versionNonce": 1740434632,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792243564506,
      "created": 1792242094473,
      "link": null,
      "locked": false,
      "text": "SÆVIT is an AI-powered digital first mate designed\nfor small-scale fishing vessels, particularly Icelandic\ncoastal fishing boats operated by a single person.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SÆVIT is an AI-powered digital first mate designed for small-scale fishing vessels, particularly Icelandic coastal fishing boats operated by a single person.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "TOIV7nmwD8qIwZK-tLugI",
      "type": "text",
      "x": 2809.9148158000394,
      "y": -1022.3340705762205,
      "width": 787.9488141635463,
      "height": 138.24156128108152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 1319066288,
      "version": 110,
      "versionNonce": 1981208752,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104873,
      "created": 1792242094473,
      "link": null,
      "locked": false,
      "text": "Our vision is to combine artificial intelligence, marine data,\ncameras, and existing fishing equipment into one intelligent\nsystem that assists fishermen during their daily\noperations.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our vision is to combine artificial intelligence, marine data, cameras, and existing fishing equipment into one intelligent system that assists fishermen during their daily operations.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ZZ5mqLQPKkS_vAUabqSYB",
      "type": "text",
      "x": 2818.665385609908,
      "y": -812.5031293460054,
      "width": 770.4476745438093,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 1906108496,
      "version": 110,
      "versionNonce": 957891248,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104873,
      "created": 1792242094474,
      "link": null,
      "locked": false,
      "text": "We want to create something similar to JARVIS, the AI\nassistant used by Iron Man, but specifically designed for\nfishermen.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We want to create something similar to JARVIS, the AI assistant used by Iron Man, but specifically designed for fishermen.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NY81PhMZOt36AN2NfHw-h",
      "type": "text",
      "x": 2830.775383985698,
      "y": -654.512773596198,
      "width": 746.2276777922286,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 826311856,
      "version": 110,
      "versionNonce": 744254640,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104873,
      "created": 1792242094474,
      "link": null,
      "locked": false,
      "text": "An assistant that can see, listen, communicate, analyze\nconditions, help with decisions, and eventually improve\nsafety at sea.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An assistant that can see, listen, communicate, analyze conditions, help with decisions, and eventually improve safety at sea.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Cro3BI-BUuxRd6LyvzHKk",
      "type": "text",
      "x": 2819.7630354048415,
      "y": -496.5224178463907,
      "width": 769.5352088814054,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 1685806672,
      "version": 111,
      "versionNonce": 1779451472,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792247815319,
      "created": 1792242094474,
      "link": null,
      "locked": false,
      "text": "SÆVIT should be able to communicate naturally with the\nfisherman in Icelandic, providing useful information\nwithout requiring the operator to stop working.",
      "fontSize": 27.648312256216304,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SÆVIT should be able to communicate naturally with the fisherman in Icelandic, providing useful information without requiring the operator to stop working.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "kVwUdMVmbJdQ-zY4mISy-",
      "type": "text",
      "x": 2821.5131945583826,
      "y": -321.2518669364474,
      "width": 764.7520566468596,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 975990448,
      "version": 110,
      "versionNonce": 1431109808,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104873,
      "created": 1792242094474,
      "link": null,
      "locked": false,
      "text": "The ultimate goal is to make single-handed fishing safer,\neasier, more efficient, and more productive.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The ultimate goal is to make single-handed fishing safer, easier, more efficient, and more productive.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "x3eAHqDH-c8lNUWpU_KU6",
      "type": "text",
      "x": 2892.1131157880614,
      "y": -180.54170634677598,
      "width": 623.5522141875023,
      "height": 34.56039032027038,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 538645584,
      "version": 110,
      "versionNonce": 524905136,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104873,
      "created": 1792242094474,
      "link": null,
      "locked": false,
      "text": "2. Our Story: Three Generations of Fishermen",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
