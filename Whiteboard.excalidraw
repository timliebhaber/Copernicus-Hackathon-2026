      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308149,
      "link": null,
      "locked": false,
      "text": "> *\"After the recent algal bloom losses in the Eastfjords and Westfjords, are\nyour aquaculture clients asking for automated satellite Early Warning\nintegrations? We want to feed Copernicus HAB risk alerts and nutrient dispersion\ntracking directly into your software, both to protect salmon pens and to\nquantify nitrogen offsetting through co-located kelp farming (IMTA).\"*",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> *\"After the recent algal bloom losses in the Eastfjords and Westfjords, are your aquaculture clients asking for automated satellite Early Warning integrations? We want to feed Copernicus HAB risk alerts and nutrient dispersion tracking directly into your software, both to protect salmon pens and to quantify nitrogen offsetting through co-located kelp farming (IMTA).\"*",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
