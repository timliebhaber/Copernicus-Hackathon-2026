      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094479,
      "link": null,
      "locked": false,
      "text": "Or:",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Or:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vCZOVq_4cJiWZ7dib01JX",
      "type": "text",
