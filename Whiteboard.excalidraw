      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094477,
      "link": null,
      "locked": false,
      "text": "The long-term goal is to allow the fisherman to operate\nthe system hands-free.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The long-term goal is to allow the fisherman to operate the system hands-free.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "n9LxTNOGJ_upFlc3DOwDN",
      "type": "text",
      "x": 3004.66940149212,
      "y": 5215.816382232584,
      "width": 398.439642779385,
      "height": 34.56039032027038,
