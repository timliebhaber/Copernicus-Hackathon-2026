      "version": 3,
      "versionNonce": 1751599816,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308137,
      "link": null,
      "locked": false,
      "text": "* **Green enzymatic/solvent extraction:** Pulling delicate antioxidants and\nfucoidans out of the cell walls without heat damage (**Taramar**).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* **Green enzymatic/solvent extraction:** Pulling delicate antioxidants and fucoidans out of the cell walls without heat damage (**Taramar**).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mT4h64922F54MWqKFzYtc",
      "type": "text",
      "x": -2909.8542310983767,
      "y": 1238.020124453602,
      "width": 756.6598510742188,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
