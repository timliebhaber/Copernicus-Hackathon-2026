      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094485,
      "link": null,
      "locked": false,
      "text": "\"We do not need to invent every technology ourselves.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"We do not need to invent every technology ourselves.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "nMyi6uko_FVowtcY1C77I",
      "type": "text",
      "x": 2832.904249546669,
      "y": 20057.03542548012,
      "width": 741.9699466702876,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3I",
      "roundness": null,
      "seed": 749189808,
      "version": 109,
      "versionNonce": 547330224,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094485,
      "link": null,
      "locked": false,
      "text": "We can use Copernicus Marine for wave and current\nforecasts, connect cameras to monitor fishing activity,\nand integrate our existing equipment.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We can use Copernicus Marine for wave and current forecasts, connect cameras to monitor fishing activity, and integrate our existing equipment.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "EKZfmtRv7xPCHmDSBWhzi",
      "type": "text",
      "x": 2927.7518307867813,
      "y": 20249.5861715502,
      "width": 552.2747841900618,
      "height": 34.56039032027038,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3J",
      "roundness": null,
      "seed": 516589648,
      "version": 109,
      "versionNonce": 344523440,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094485,
      "link": null,
      "locked": false,
      "text": "SÆVIT brings this information together.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SÆVIT brings this information together.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "_H057f6PW1uXWOmySMRDf",
      "type": "text",
      "x": 2817.6701109765563,
      "y": 20303.895356339195,
      "width": 772.4382238105118,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3K",
      "roundness": null,
      "seed": 1866261680,
      "version": 109,
      "versionNonce": 1538600112,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094485,
      "link": null,
      "locked": false,
      "text": "Our goal is to develop a system that can assist with\nfishing decisions, identify which rod produces each catch,\nand automatically record useful information.\"",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our goal is to develop a system that can assist with fishing decisions, identify which rod produces each catch, and automatically record useful information.\"",
