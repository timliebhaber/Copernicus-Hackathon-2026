    },
    {
      "id": "T6LNY1bF_JWhc3DyBeDyO",
      "type": "text",
      "x": 2928.70567080039,
      "y": 10928.155182311559,
      "width": 550.3671041628445,
      "height": 34.56039032027038,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1o",
