      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308137,
      "link": null,
      "locked": false,
      "text": "* **Mechanical milling:** Grinding calcified algae into micronized mineral powders\n(**Íslenska Kalkþörungafélagið**).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* **Mechanical milling:** Grinding calcified algae into micronized mineral powders (**Íslenska Kalkþörungafélagið**).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Dnx8XU4Ma3fVZEkQF11bg",
      "type": "text",
      "x": -2900.7043287546267,
      "y": 1190.520124453602,
      "width": 738.3600463867188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
