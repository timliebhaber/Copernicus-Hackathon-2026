      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094484,
      "link": null,
      "locked": false,
      "text": "\"We are three generations of fishermen. My father, my two\nbrothers and I are all skippers of our own fishing boats.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"We are three generations of fishermen. My father, my two brothers and I are all skippers of our own fishing boats.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "1Bb3sg0Y1BqAiJcklpLg8",
      "type": "text",
      "x": 2814.089617413957,
      "y": 17028.06407383928,
      "width": 779.5992109357104,
      "height": 138.24156128108152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2q",
      "roundness": null,
      "seed": 254291632,
      "version": 109,
      "versionNonce": 1570013360,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094484,
      "link": null,
      "locked": false,
      "text": "We know what it means to work alone at sea. One person\nmust navigate, operate the fishing equipment, monitor the\nweather, handle the catch and take responsibility for\nsafety.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We know what it means to work alone at sea. One person must navigate, operate the fishing equipment, monitor the weather, handle the catch and take responsibility for safety.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "R2PhLTRNHcFGChi24hF2K",
      "type": "text",
      "x": 2944.9490060360868,
      "y": 17272.455405389763,
      "width": 517.8804336914508,
      "height": 34.56039032027038,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
