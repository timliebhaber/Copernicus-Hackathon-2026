      "index": "b4g",
      "roundness": null,
      "seed": 226150840,
      "version": 3,
      "versionNonce": 748529080,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308137,
      "link": null,
      "locked": false,
      "text": "* **Polymer extraction & compounding:** Extracting polysaccharides\n(alginates/agar) and blending them with plasticizers to extrude biodegradable\npackaging films (**Marea**).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* **Polymer extraction & compounding:** Extracting polysaccharides (alginates/agar) and blending them with plasticizers to extrude biodegradable packaging films (**Marea**).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
