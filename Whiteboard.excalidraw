      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094481,
      "link": null,
      "locked": false,
      "text": "Supporting an emergency alert procedure.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Supporting an emergency alert procedure.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "w_mVMGq_EoHl5lPeizuQV",
      "type": "text",
      "x": 2890.398988170012,
      "y": 10955.309774706058,
      "width": 626.9804694236001,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1p",
      "roundness": null,
      "seed": 1278252112,
      "version": 109,
      "versionNonce": 3041968,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094481,
      "link": null,
      "locked": false,
      "text": "Potentially integrating with suitable emergency\ncommunication hardware.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Potentially integrating with suitable emergency communication hardware.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Ua2Q6HG-ZNSh_Ng20M7Th",
      "type": "text",
      "x": 2814.960558053812,
      "y": 11017.024757420826,
      "width": 777.8573296560012,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1q",
      "roundness": null,
      "seed": 1007524016,
      "version": 109,
      "versionNonce": 2121110704,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094481,
      "link": null,
      "locked": false,
      "text": "For example, if the system detects a suspected accident,\nit could initiate a defined warning and confirmation\nprocedure.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For example, if the system detects a suspected accident, it could initiate a defined warning and confirmation procedure.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "eeqZHRU4-pkfoxIRW_gSf",
      "type": "text",
      "x": 2840.0514050424404,
      "y": 11192.29530833077,
      "width": 727.675635678744,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1r",
      "roundness": null,
      "seed": 129600080,
      "version": 109,
      "versionNonce": 2134343344,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094481,
      "link": null,
      "locked": false,
      "text": "However, this is a future development objective, not a\ncurrently validated safety system.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "However, this is a future development objective, not a currently validated safety system.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "74HPaRjFfLgGC8scD5DcN",
      "type": "text",
      "x": 2820.5178596564933,
      "y": 11298.44507860017,
      "width": 766.7427264506377,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1s",
      "roundness": null,
      "seed": 305595056,
      "version": 109,
      "versionNonce": 1664362672,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094481,
      "link": null,
      "locked": false,
      "text": "A camera-based AI system must not replace approved\nman-overboard equipment, emergency beacons, lifejackets,\nor established maritime safety procedures.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A camera-based AI system must not replace approved man-overboard equipment, emergency beacons, lifejackets, or established maritime safety procedures.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BPwd9yQZQViAapbwvBOMe",
      "type": "text",
      "x": 2810.578312132761,
      "y": 11456.435434349978,
      "width": 786.6218214981033,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1t",
      "roundness": null,
      "seed": 313770064,
      "version": 109,
      "versionNonce": 906728112,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094481,
      "link": null,
      "locked": false,
      "text": "Any automated emergency activation would require\nextensive testing, reliable communications, and appropriate\nsafeguards.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Any automated emergency activation would require extensive testing, reliable communications, and appropriate safeguards.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "u4P7jGB7f5S_xIpzNZ2PW",
      "type": "text",
      "x": 2816.4259574163298,
      "y": 11631.705985259921,
      "width": 774.9265309309656,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1u",
      "roundness": null,
      "seed": 1940073648,
      "version": 109,
      "versionNonce": 1315290288,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094481,
      "link": null,
      "locked": false,
      "text": "Our ambition is to give a fisherman working alone another\nlayer of awareness and assistance.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our ambition is to give a fisherman working alone another layer of awareness and assistance.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
