      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094484,
      "link": null,
      "locked": false,
      "text": "That is the problem we want to solve.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "That is the problem we want to solve.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
