      "versionNonce": 642148016,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094486,
      "link": null,
      "locked": false,
      "text": "We have the experience. We have tested equipment. And\nnow, with Copernicus and AI, we can bring these\ntechnologies together.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We have the experience. We have tested equipment. And now, with Copernicus and AI, we can bring these technologies together.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
