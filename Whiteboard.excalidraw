    {
      "id": "V4Y7ty8sp0rcwCe7Ut6Xr",
      "type": "text",
      "x": -2903.4442884714235,
      "y": 3040.520124453602,
      "width": 743.8399658203125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
