      "created": 1792242094477,
      "link": null,
      "locked": false,
      "text": "5. What Is SÆVIT?",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. What Is SÆVIT?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "EaLDi9ErxdaKX8T2a1JYd",
      "type": "text",
      "x": 2858.2854402161843,
      "y": 4129.63268645266,
      "width": 691.2075653312563,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Y",
      "roundness": null,
      "seed": 396626096,
      "version": 109,
      "versionNonce": 539129008,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094477,
      "link": null,
      "locked": false,
      "text": "SÆVIT is an AI-powered assistant that combines\ninformation from multiple sources and communicates\ndirectly with the fisherman.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SÆVIT is an AI-powered assistant that combines information from multiple sources and communicates directly with the fisherman.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "eV7Ui5gicvYdSsTPzT76e",
      "type": "text",
      "x": 2846.078710837213,
      "y": 4304.9032373626,
      "width": 715.6210240891987,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Z",
      "roundness": null,
      "seed": 721558096,
      "version": 109,
      "versionNonce": 1464884912,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094477,
      "link": null,
      "locked": false,
      "text": "It is not intended to be just another fishing app. It\nshould act as an intelligent companion on board.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is not intended to be just another fishing app. It should act as an intelligent companion on board.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
