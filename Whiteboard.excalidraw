      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094479,
      "link": null,
      "locked": false,
      "text": "When the fisherman opens SÆVIT, the system displays a\nmap showing the vessel’s position.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When the fisherman opens SÆVIT, the system displays a map showing the vessel’s position.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "UwRv4BA-0sWRvz3FzAOLP",
      "type": "text",
      "x": 2816.8959314741514,
      "y": 7548.642728850835,
      "width": 773.9865828153215,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1D",
      "roundness": null,
      "seed": 1709429328,
      "version": 110,
      "versionNonce": 2091642544,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094479,
      "link": null,
      "locked": false,
      "text": "The fisherman can view available ocean forecasts for the\nsurrounding area.",
      "fontSize": 27.648312256216304,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The fisherman can view available ocean forecasts for the surrounding area.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "7kazecs0FfR3s26O9KLpI",
      "type": "text",
      "x": 2826.918438640176,
      "y": 7654.792499120238,
      "width": 753.9415684832722,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1E",
      "roundness": null,
      "seed": 951401136,
      "version": 109,
      "versionNonce": 412784816,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094479,
      "link": null,
      "locked": false,
      "text": "SÆVIT should present the information in a simple,\npractical format rather than overwhelming the user with\ncomplex scientific data.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SÆVIT should present the information in a simple, practical format rather than overwhelming the user with complex scientific data.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "RcUuvKofFzEEcsMhXMu-r",
      "type": "text",
      "x": 3121.5940562863993,
      "y": 7847.343245190314,
      "width": 164.59033319082593,
      "height": 34.56039032027038,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1F",
      "roundness": null,
      "seed": 1146423376,
      "version": 109,
      "versionNonce": 1428423344,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094479,
      "link": null,
      "locked": false,
      "text": "For example:",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For example:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "KY0Hd_gvIv2YgqExmf96N",
      "type": "text",
      "x": 2837.0239054484928,
      "y": 7874.497837584811,
      "width": 733.7306348666392,
      "height": 69.12078064054076,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1G",
      "roundness": null,
      "seed": 496657584,
      "version": 109,
      "versionNonce": 1357917360,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094479,
      "link": null,
      "locked": false,
      "text": "“The forecast indicates increasing wave height in your\narea during the afternoon.”",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“The forecast indicates increasing wave height in your area during the afternoon.”",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "bdTpc0f2UB9zypoXA7E9h",
      "type": "text",
      "x": 3183.940969687213,
      "y": 8015.207998174486,
      "width": 39.89650638919898,
      "height": 34.56039032027038,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
