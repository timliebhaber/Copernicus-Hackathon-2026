      "text": "SÆVIT is not simply another marine weather application.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SÆVIT is not simply another marine weather application.",
