      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094478,
      "link": null,
      "locked": false,
      "text": "Intelligent Fishing Assistance",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Intelligent Fishing Assistance",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mX3AwzLltLK3nPTXNvB6X",
      "type": "text",
      "x": 2826.296437195735,
      "y": 5225.690779466946,
      "width": 755.1855713721545,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0m",
      "roundness": null,
      "seed": 1624616624,
      "version": 109,
      "versionNonce": 739213488,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094478,
      "link": null,
      "locked": false,
      "text": "SÆVIT could combine marine forecasts, vessel position,\nprevious fishing activity, and other available information\nto support decisions about fishing locations.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SÆVIT could combine marine forecasts, vessel position, previous fishing activity, and other available information to support decisions about fishing locations.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "HfkKq7WEz0Wiw8_TsUbI0",
      "type": "text",
      "x": 2857.3178288416866,
      "y": 5383.681135216753,
      "width": 693.1427880802516,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 61199440,
      "version": 109,
      "versionNonce": 2042358448,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094478,
      "link": null,
      "locked": false,
      "text": "It is important to distinguish between favorable\nenvironmental conditions and scientifically validated\npredictions of fish presence.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is important to distinguish between favorable environmental conditions and scientifically validated predictions of fish presence.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "gN2rwf2jqfA-WA-LsxBR9",
      "type": "text",
      "x": 2828.300908494671,
      "y": 5541.671490966561,
      "width": 751.1766287742826,
      "height": 103.68117096081113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 1368152240,
      "version": 109,
      "versionNonce": 1783305392,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094478,
      "link": null,
      "locked": false,
      "text": "Initially, SÆVIT should recommend areas based on\nconditions and clearly explain the information behind its\nrecommendations.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Initially, SÆVIT should recommend areas based on conditions and clearly explain the information behind its recommendations.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
