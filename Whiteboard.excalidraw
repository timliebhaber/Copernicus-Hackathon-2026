      "boundElements": null,
      "updated": 1792242104874,
      "created": 1792242094485,
      "link": null,
      "locked": false,
      "text": "\"Our long-term vision goes beyond catching fish.",
      "fontSize": 27.6483122562163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Our long-term vision goes beyond catching fish.",
