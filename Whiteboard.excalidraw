      "versionNonce": 194524344,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792248308151,
      "created": 1792248308129,
      "link": null,
      "locked": false,
      "text": "To sound like an insider on your call, use the specific operational terminology for\neach supply chain and highlight where their bottlenecks (and your data\nopportunities) lie:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To sound like an insider on your call, use the specific operational terminology for each supply chain and highlight where their bottlenecks (and your data opportunities) lie:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "j7y3atXDO_qjJzG3TgBzU",
      "type": "text",
      "x": -2841.284284809314,
      "y": -396.97987554639803,
      "width": 619.5199584960938,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
