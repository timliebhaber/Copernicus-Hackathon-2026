      "link": null,
      "locked": false,
      "text": "3. **Biorefinery & Extraction:**",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. **Biorefinery & Extraction:**",
